{
  "name": "laravel-admin-blade-ui-next",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./resources/css/bpadmin.css -o ./public/bpadmin/bpadmin.css --minify",
    "dev": "tailwindcss -i ./resources/css/bpadmin.css -o ./public/bpadmin/bpadmin.css --watch",
    "dev:js": "esbuild resources/js/bpadmin.js --bundle --outfile=public/bpadmin/bpadmin.js --watch",
    "build:js": "esbuild resources/js/bpadmin.js --bundle --minify --outfile=public/bpadmin/bpadmin.js",
    "build:all": "npm run build && npm run build:js"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.15.11",
    "alpinejs": "^3.14.0"
  }
}
